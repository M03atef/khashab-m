# انسخ الملف ده لـ .env.local على جهازك، أو حط القيم في Vercel → Settings → Environment Variables

# «مستشار خشبة» (رفع صورة المكان → اقتراح أساسي + بديلين)
# مفتاح مجاني من Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# اختياري: ترتيب الموديلات (مفصولة بفاصلة). الافتراضي موديلات الخطة المجانية.
# GEMINI_MODEL=gemini-3.6-flash,gemini-3.1-flash-lite

# «شوفها في مكانك»: بيرجّع نفس صورة العميل وفيها القطعة المقترحة.
# مهم: موديلات تعديل الصور مش في الخطة المجانية — لازم تفعّل Billing على مشروع المفتاح في Google AI Studio.
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview,gemini-2.5-flash-image

# اختياري (مدفوع): لو حطيت مفتاح Claude بيتستخدم لو Gemini مش متاح
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5

# اختياري: رابط الموقع النهائي (لصورة المعاينة على واتساب وفيسبوك)
# NEXT_PUBLIC_SITE_URL=https://khashab-m-b2lb.vercel.app
