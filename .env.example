# مثال على متغيرات البيئة المطلوبة
# انسخ الملف ده لـ .env.local على جهازك أو حط القيم في Vercel

# مفتاح Gemini API من Google AI Studio
# احصل عليه من: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# قاعدة البيانات (SQLite - Vercel بيستخدم /tmp لأنه read-only)
DATABASE_URL=file:/tmp/custom.db
